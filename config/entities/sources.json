{
  "entity": "sources",
  "table": "openalex.sources",
  "id_prefix": "S",
  "version_field": "updated_date",
  "predicate": null,
  "filter_version": "none.v1",

  "consumed_fields": {
    "id": "去前缀取数字部分 → 主键 id",
    "updated_date": "ISO8601(UTC) 截到毫秒 → source_updated_at"
  },

  "typed_columns": {
    "display_name":   { "column": "display_name",   "type": "string", "max_len": 1024, "truncate": true },
    "type":           { "column": "source_type",    "type": "string", "max_len": 32 },
    "issn_l":         { "column": "issn_l",         "type": "string", "max_len": 9 },
    "country_code":   { "column": "country_code",   "type": "string", "max_len": 2 },
    "is_oa":          { "column": "is_oa",          "type": "bool" },
    "is_in_doaj":     { "column": "is_in_doaj",     "type": "bool" },
    "works_count":    { "column": "works_count",    "type": "int" },
    "cited_by_count": { "column": "cited_by_count", "type": "int" }
  },

  "payload_fields": [
    "ids", "summary_stats", "homepage_url", "issn", "alternate_titles",
    "host_organization", "host_organization_name", "host_organization_lineage",
    "societies", "apc_prices", "apc_usd", "counts_by_year", "topics",
    "is_core", "is_ojs", "is_in_scielo", "is_high_oa_rate",
    "is_in_doaj_since_year", "is_high_oa_rate_since_year", "oa_flip_year",
    "first_publication_year", "last_publication_year", "oa_works_count",
    "created_date"
  ],

  "drop_fields": [
    "works_api_url",
    "topic_share"
  ],

  "_notes": [
    "consumed(2) + typed(8) + payload(24) + drop(2) = 36 = 2026-06-26 快照两分区取样实测字段全集",
    "快照中出现不在上述任何集合的字段 → 记录仍按白名单处理, 另发 schema_drift 死信采样告警(契约 C5)",
    "drop 依据: works_api_url 可由 id 推导; topic_share 与 topics 同构冗余(肥记录 42.7% 字节)"
  ]
}
